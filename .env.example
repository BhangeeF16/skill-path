# SkillPath database connection. Server-side only — never referenced from client code.
#
# Local development (docker compose up -d):
COGNODB_URI=bolt://localhost:7687
COGNODB_USERNAME=neo4j
COGNODB_PASSWORD=skillpath-local

# CognoDB Cloud — swap these three values, nothing else changes:
# COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
# COGNODB_USERNAME=cognodb
# COGNODB_PASSWORD=<your-password>
